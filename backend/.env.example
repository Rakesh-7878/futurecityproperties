SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=

# --- INSTRUCTIONS ---
# 1. Copy this file to .env (never commit .env to git)
# 2. Fill in values from your Supabase project dashboard:
#    - Project URL -> Settings -> API -> Project URL
#    - ANON KEY (public/safe for browser JS) -> Settings -> API -> anon public
#    - SERVICE ROLE KEY (SECRET, server/Edge Function only) -> Settings -> API -> service_role
# 3. Set SITE_URL to your deployed domain (e.g. https://futurecityproperties.in)
# 4. The SERVICE_ROLE_KEY must ONLY ever be set as a Supabase Edge Function secret
#    It must NEVER appear in frontend JavaScript, HTML, or be committed to source control.
